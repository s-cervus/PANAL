<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="APCPA.MainPage"
             
             Loaded="Login_Load">

//>>

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">


            <Grid
                ColumnDefinitions="*,*,*,*,*,*"
                ColumnSpacing="10"
                RowDefinitions="*,*,*,*,*,*,*"
                RowSpacing="10">


                <Label
                    Text="Bienvenido"
                    FontSize="30"
                    HorizontalOptions="Center"
                    VerticalTextAlignment="Center"
                    Grid.Column="1"
                    Grid.Row="0"/>

                <Label
                    Text="Vamos a iniciar sesión"
                    HorizontalTextAlignment="Center"
                    Grid.Column="1"
                    Grid.Row="0"/>






                <Label
                    Text="Usuario:"
                    Grid.Column="1"
                    Grid.Row="2"/>
                

                <Entry
                    x:Name="user"
                    Placeholder="Usuario"
                    Grid.Column="2"
                    Grid.Row="2"/>

                <Label
                    Text="Contraseña:"/>

                <Entry
                    x:Name="password"
                    Placeholder="Contraseña"/>

                <Button
                    Text="Iniciar Sesión"
                   Clicked="RegisterBTN"/>

                <Button
                    Text="Registrarse"
                    Clicked="RegisterBTN"/>



            </Grid>
            

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
