<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="APCPA.MainPage"
             BackgroundImageSource="in4display1a.png"
             >



    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            
            <Label
                Text="¡BIENVENIDOS!"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="Usuario:  "
                SemanticProperties.HeadingLevel="Level5" />

            <Entry/>

            <Label
                Text="Contraseña:  "
                SemanticProperties.HeadingLevel="Level5" />

            <Entry Text=" "/>

            <Button
                x:Name="Count"
                Text="Iniciar Sesión"
                Clicked="RegisterBTN"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
