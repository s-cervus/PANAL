<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="APCPA.MainPage"
             BackgroundImageSource="in4display1a.png"
             >



    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            
            <Label
                Text="¡BIENVENIDOS!"
                FontSize="30"
                HorizontalOptions="Center" />
                

            <Label
                Grid.Column="0"
                Text="Usuario:  "
                FontSize="16"
                />

            <Entry
                Grid.Column="1"
                Placeholder="Escribe tu usuario"
                HorizontalOptions="Center"/>
            

            <Label
                Text="Contraseña:  "
                SemanticProperties.HeadingLevel="Level5" />

            <Entry Text=" "/>

            <Button
                x:Name="CounterBtn"
                Text="Iniciar Sesión"
                Clicked="OnCounterClicked"
                />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
